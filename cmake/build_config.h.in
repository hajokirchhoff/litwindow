#ifndef _LITWINDOW_BUILD_CONFIG_H
#define _LITWINDOW_BUILD_CONFIG_H

// Generated by CMake (cmake/build_config.h.in) and installed over the default
// litwindow/build_config.h. Describes the installed litwindow libraries, so
// consumers that do not use CMake (e.g. MSBuild projects) need no extra
// defines or linker settings.
//
// Every definition is guarded: a consumer using the CMake targets gets the
// same macros from the target's INTERFACE_COMPILE_DEFINITIONS and the guards
// avoid redefinition warnings.

// The installed libraries are plain lwbase.lib, lwodbc.lib, lwwx.lib; they
// do not follow the boost auto link naming scheme. Linking is done by the
// build system (CMake targets, or vcpkg's MSBuild integration).
#ifndef LITWINDOW_ALL_NO_LIB
#define LITWINDOW_ALL_NO_LIB
#endif
#ifndef LWL_ALL_NO_LIB
#define LWL_ALL_NO_LIB 1
#endif
#ifndef LWL_LWBASE_NO_LIB
#define LWL_LWBASE_NO_LIB
#endif
#ifndef LITWINDOW_ODBC_NO_LIB
#define LITWINDOW_ODBC_NO_LIB
#endif
#ifndef LITWINDOW_LWWX_NO_LIB
#define LITWINDOW_LWWX_NO_LIB
#endif

// The installed libraries were built as DLLs.
#if @LITWINDOW_INSTALLED_SHARED@
#ifndef LITWINDOW_ALL_DYN_LINK
#define LITWINDOW_ALL_DYN_LINK
#endif
#ifndef BOOST_ALL_DYN_LINK
#define BOOST_ALL_DYN_LINK
#endif
#endif

#endif